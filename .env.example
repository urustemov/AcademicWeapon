# Google Identity Services Web client ID (not the client secret).
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
GOOGLE_WORKSPACE_DOMAIN=auca.kg

# Local development uses development. Hosting must use production.
APP_ENV=development

# Keep real records separate from the synthetic demo database.
APSS_DEMO_MODE=0
APSS_DB_PATH=academic_weapon.sqlite3

# Hosting: generate a long random secret in the provider dashboard.
# Local development can leave this empty and use .apss_local_secret instead.
SESSION_SECRET=

# Hosting must use 1 because the public site is served over HTTPS.
SESSION_COOKIE_SECURE=0
SESSION_TTL_SECONDS=43200

# Comma-separated hostnames accepted by the application.
ALLOWED_HOSTS=127.0.0.1,localhost

# Hosting only: redirect the provider alias to the official university domain.
# Leave blank for local development.
CANONICAL_HOST=
CANONICAL_ALIAS_HOSTS=

# Authentication throttle: attempts per IP inside the configured window.
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=900

# Weekly check-in and displayed dates use university local time.
ACADEMIC_TIMEZONE=Asia/Bishkek

# Native Advising Team AAC Tracker. Keep the shared key secret.
AAC_TRACKER_API_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
AAC_TRACKER_API_KEY=
